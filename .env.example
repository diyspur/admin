NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin account credentials for optional dev-login helper
ADMIN_DEFAULT_EMAIL=admin@diyspur.com
ADMIN_DEFAULT_PASSWORD=replace-with-admin-password
NEXT_PUBLIC_ADMIN_DEV_AUTH=false

# Optional: Supabase service role key for migrations/seed scripts
SUPABASE_SERVICE_ROLE_KEY=
